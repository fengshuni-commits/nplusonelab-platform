{
  "manifest_version": 3,
  "name": "N+1 LAB 采购助手 v7.7.2",
  "version": "7.7.2",
  "description": "采购自动化 + 淘宝订单字段提取增强版",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://buyertrade.taobao.com/*",
    "https://trade.taobao.com/*",
    "https://myseller.taobao.com/*",
    "https://invoice.taobao.com/*",
    "https://platform.nplusonelab.com/*",
    "http://43.156.225.39:8080/*",
    "http://localhost:8080/*",
    "http://43.156.225.39:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://buyertrade.taobao.com/*",
        "https://trade.taobao.com/*",
        "https://myseller.taobao.com/*",
        "https://invoice.taobao.com/*",
        "https://platform.nplusonelab.com/*",
        "http://43.156.225.39:8080/*",
        "http://localhost:8080/*",
        "http://43.156.225.39:8000/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "N+1 LAB 采购助手"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.png",
        "*.html",
        "*.svg",
        "popup.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
